# Copy this to .env.local and fill in real values.
# Never commit .env.local, it's already in .gitignore.

# --- Owned by ASR lead (person 1) ---
# Base URL of the FastAPI ASR service (no trailing slash).
TALESHIFT_ASR_SERVICE_URL=http://localhost:8000

# --- Owned by NLP/scoring lead (person 4) ---
ANTHROPIC_API_KEY=

# --- Owned by persistence lead (person 5) ---
# Supabase project connection string (Project Settings -> Database ->
# Connection string -> "URI" tab). Used by packages/db (Drizzle) to
# run queries and migrations directly against Postgres.
DATABASE_URL=

# Supabase project API settings (Project Settings -> API). The anon key
# is safe to expose to the browser (hence NEXT_PUBLIC_) - Supabase's
# Row Level Security policies, not secrecy of this key, protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Any long random string (e.g. `openssl rand -hex 32`). Signs the
# student PIN-login session cookie - see
# apps/web/lib/auth/student-session.ts. Keep this secret; rotating it
# logs out every learner session.
STUDENT_SESSION_SECRET=
